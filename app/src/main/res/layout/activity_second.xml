<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".SecondActivity">

    <Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="@string/article_title"
        android:navigationIcon="@drawable/arrow_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/articleTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/article2_title"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:layout_marginBottom="12dp" />

            <ImageView
                android:id="@+id/articleImage"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="16dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/article2_title"
                tools:src="@drawable/ic_launcher_background" />

            <TextView
                android:id="@+id/articleLead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/article2_lead"
                android:textSize="19sp"
                android:textStyle="bold|italic"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/articleBody1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/article2_body1"
                android:textSize="16sp"
                android:textAlignment="viewStart"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/articleBody2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/article2_body2"
                android:textSize="16sp"
                android:textAlignment="center"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/articleBody3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/article2_body3"
                android:textSize="16sp"
                android:textColor="#555555"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="24dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/mark_as_read"
                    android:textSize="17sp" />

                <Switch
                    android:id="@+id/readSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
